{
  "name": "David merges protected branches",
  "target": "branch",
  "enforcement": "active",
  "bypass_actors": [
    {
      "actor_id": 72062250,
      "actor_type": "User",
      "bypass_mode": "pull_request"
    }
  ],
  "conditions": {
    "ref_name": {
      "include": ["refs/heads/dev", "refs/heads/master"],
      "exclude": []
    }
  },
  "rules": [
    {
      "type": "update",
      "parameters": {
        "update_allows_fetch_and_merge": false
      }
    }
  ]
}
